# Preserve authenticated release artifacts and deterministic generated inventories.
.conceptor/**/*.toml text eol=lf
release/**/*.json text eol=lf
release/**/*.mjs text eol=lf
release/**/*.md text eol=lf

# Legacy ingress includes mixed line endings; preserve its exact sealed bytes.
release/project-data-migrations/artifacts/legacy-unversioned-to-baseline.mjs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
release/project-data-migrations/artifacts/legacy-unversioned-baseline-validation.mjs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# The prepared plugin carries exact third-party runtime bytes for standalone use.
plugins/conceptor-v3/runtime/conceptor/node_modules/** binary
